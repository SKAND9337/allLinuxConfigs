# Keep terminal-startup output before Powerlevel10k instant prompt.
[[ $- == *i* ]] || return

if [[ -t 1 ]] && (( $+commands[fastfetch] )); then
    fastfetch
fi

# Enable Powerlevel10k instant prompt.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Disable Oh-My-Zsh compaudit permission checking to speed up compinit
export ZSH_DISABLE_COMPFIX="true"

source /usr/share/cachyos-zsh-config/cachyos-config.zsh

[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
export EDITOR=micro

# SLSsteam: Add wrapper to PATH
export PATH="$HOME/.local/share/SLSsteam/path:$PATH"

# Cached zoxide init to avoid spawning subshell on every launch
if (( $+commands[zoxide] )); then
    [[ ! -f ~/.cache/zsh/zoxide.zsh ]] && { mkdir -p ~/.cache/zsh; zoxide init zsh > ~/.cache/zsh/zoxide.zsh; }
    source ~/.cache/zsh/zoxide.zsh
fi
