layout {

    focus-ring {
        active-color   "#c1928b"
        inactive-color "#231b1a"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#c1928b"
        inactive-color "#231b1a"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#c1928b"
        inactive-color "#6a372f"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#c1928b80"
    }
}

recent-windows {
    highlight {
        active-color "#c1928b"
        urgent-color "#fd4663"
    }
}
