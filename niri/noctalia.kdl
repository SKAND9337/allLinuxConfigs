layout {

    focus-ring {
        active-color   "#678de4"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#678de4"
        inactive-color "#000000"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#678de4"
        inactive-color "#143685"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#678de480"
    }
}

recent-windows {
    highlight {
        active-color "#678de4"
        urgent-color "#fd4663"
    }
}
