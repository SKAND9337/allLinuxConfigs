/*****----- Configuration -----*****/
configuration {
    modi:                       "drun,filebrowser";
    show-icons:                 true;
    display-drun:               "";
    display-filebrowser:        "";
    drun-display-format:        "{name} [<span weight='light' size='small'><i>({generic})</i></span>]";
    window-format:              "{w}   {c}   {t}";
}

/*****----- Global Properties -----*****/
/* Import the dynamic color variables */
@import "~/.config/rofi/noctalia.rasi"

* {
    font:                        "Iosevka Nerd Font 13";
}

/*****----- Main Window -----*****/
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       800px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border-radius:               9px;
    cursor:                      "default";
    background-color:            black / 65%;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     35px;
    padding:                     40px;
    background-color:            transparent;
    children:                    [ "inputbar", "message","listview", "mode-switcher" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px 100px;
    padding:                     5px;
    border:                      2px;
    border-radius:               100%;
    border-color:                @border;
    background-color:            transparent;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    padding:                     8px 11px;
    border-radius:               100%;
    background-color:            @accent;
    text-color:                  @accent-fg;
    str:                         "";
}
entry {
    enabled:                     true;
    padding:                     7px 12px;
    border:                      1px;
    border-color:				 @border;
    border-radius:				 3%;
    background-color:            @bg;
    text-color:                  @fg;
    cursor:                      text;
    placeholder:                 "Ready to search...";
    placeholder-color:           inherit;
    vertical-align:              0.0;
    horizontal-align:            0.0;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     3;
    lines:                       7;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     7px;
    background-color:            transparent;
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     5px;
    margin:                      3px;
    padding:                     6px;
    border:                      3px;
    border-radius:               100%;
    border-color:                @border;
    background-color:            transparent;
    text-color:                  @fg;
    cursor:                      pointer;
}
element normal.active {
    background-color:            @bg-alt;
    text-color:                  @accent;
}
element selected.normal {
    background-color:            @accent;
    text-color:                  @accent-fg;
}
element selected.active {
    background-color:            @accent;
    text-color:                  @accent-fg;
}
element-icon {
    background-color:            transparent;
    size:                        25px;
    cursor:                      inherit;
}
element-text {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    cursor:                      inherit;
    horizontal-align:            0.0;
}

/*****----- Mode Switcher -----*****/
mode-switcher{
    enabled:                     true;
    expand:                      false;
    spacing:                     0px;
    margin:                      0px 200px;
    padding:                     12px;
    border: 					 2px;
    border-radius:               100%;
    background-color:            @bg-alt;
}
button {
    background-color:            inherit;
    text-color:                  @fg;
    cursor:                      pointer;
}
button selected {
    background-color:            inherit;
    text-color:                  @accent;
}

/*****----- Message -----*****/
error-message {
    padding:                     20px;
    background-color:            @bg-alt;
    text-color:                  @fg;
}
message {
    padding:                     0px;
    background-color:            inherit;
    text-color:                  @accent;
}
textbox {
    padding:                     0px;
    border-radius:               0px;
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
